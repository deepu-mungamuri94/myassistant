{
  "name": "myassistant",
  "version": "1.0.0",
  "description": "Personal AI Assistant - Secure storage for credentials, cards, health, investments, and more",
  "main": "index.js",
  "scripts": {
    "sync": "npx cap sync",
    "open:android": "npx cap open android",
    "prebuild": "npm test",
    "build": "npx cap copy && npx cap sync",
    "watch": "npx chokidar-cli \"www/**/*\" -c \"npm run build\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "git config core.hooksPath .githooks"
  },
  "keywords": [
    "personal-assistant",
    "ai",
    "secure-storage",
    "capacitor"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^9.1.2",
    "@capacitor-community/sqlite": "^7.0.2",
    "@capacitor-mlkit/barcode-scanning": "^7.3.0",
    "@capacitor/android": "^7.6.7",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/cli": "^7.6.7",
    "@capacitor/core": "^7.6.7",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/share": "^7.0.2",
    "@capacitor/status-bar": "^7.0.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "chokidar-cli": "^3.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "vitest": "^2.1.9"
  }
}
